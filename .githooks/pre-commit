#!/usr/bin/env bash
# Leak guard for this PUBLIC repo — a thin wrapper over scripts/deny-sweep.sh.
#
# Internal engineering material is never committed here. This hook refuses to stage
# private-only paths, or added lines carrying content that must never appear on a public
# ref. It does not reimplement the pattern grammar: three divergent copies disagreed once,
# and one of them would have failed CI on the project's own public identity.
#
# DEFENCE IN DEPTH, not the control. The control is scripts/gate.sh plus the attestation
# it requires — see docs/doctrine/publishing.md, including what a local hook cannot
# guarantee.
#
#   CASA_DENY_FILE        overrides the pattern file (tests use a synthetic one)
#   CASA_DENY_SUPPLEMENT  optional private pattern file with exact literals
#
# Installed by `make setup` (which sets `git config core.hooksPath .githooks`).
set -euo pipefail

sweep="$(cd "$(dirname "$0")/../scripts" && pwd)/deny-sweep.sh"
if [ ! -x "$sweep" ]; then
  echo "✋ pre-commit: $sweep is missing or not executable — run ./scripts/setup-dev.sh" >&2
  exit 1
fi

if ! "$sweep" staged; then
  echo "   Redaction is not the fix — this content does not belong on a public ref." >&2
  echo "   Internal engineering material belongs in the private repo, not here." >&2
  exit 1
fi
exit 0
