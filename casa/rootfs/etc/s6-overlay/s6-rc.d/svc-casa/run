#!/command/with-contenv bashio
# 5.5 item 3: strip ANSI from bashio output for clean docker logs.
export BASHIO_LOG_NO_COLORS=true
export NO_COLOR=1

# bashio::config returns "null" for empty optional strings; normalize to empty
_public_url="$(bashio::config 'public_url')"
if [ "$_public_url" = "null" ] || [ -z "$_public_url" ]; then
    export PUBLIC_URL=""
else
    export PUBLIC_URL="$_public_url"
fi
export CLAUDE_CODE_OAUTH_TOKEN="$(bashio::config 'claude_oauth_token')"
# v0.131.0: CLI 2.1.219 changed the default nested-subagent spawn depth from
# 1 to 3. This pin is LOAD-BEARING for the assistant resident, whose role
# config ships `disallowed: []` (defaults/roles/resident/assistant/role.yaml)
# — Agent/Task spawns bypass allowed_tools (tools.py Q-1 note), so without
# the pin it would inherit depth-3 nesting. Roles that deny Agent/Task keep
# denying; for them this is a drift guard. Inherited by every in-process SDK
# agent's CLI subprocess (all use cli_path=/usr/local/bin/claude —
# see claude_runtime.py).
export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=1
export OP_SERVICE_ACCOUNT_TOKEN="$(bashio::config 'onepassword_service_account_token')"
export ONEPASSWORD_DEFAULT_VAULT="$(bashio::config 'onepassword_default_vault')"
_hindsight_url="$(bashio::config 'hindsight_api_url')"
if [ "$_hindsight_url" != "null" ] && [ -n "$_hindsight_url" ]; then
    export HINDSIGHT_API_URL="$_hindsight_url"
    # Setting hindsight_api_url is the single toggle for long-term memory:
    # casa_core requires MEMORY_BACKEND=hindsight (anything else → noop), and
    # nothing else sets it, so derive it here. Respect an explicit override.
    export MEMORY_BACKEND="${MEMORY_BACKEND:-hindsight}"
fi
export TELEGRAM_BOT_TOKEN="$(bashio::config 'telegram_bot_token')"
export TELEGRAM_CHAT_ID="$(bashio::config 'telegram_chat_id')"
_tg_transport="$(bashio::config 'telegram_transport')"
export TELEGRAM_TRANSPORT="${_tg_transport:-polling}"
export TELEGRAM_ENGAGEMENT_SUPERGROUP_ID="$(bashio::config 'telegram_engagement_supergroup_id')"
# telegram_bot_api_base is optional (schema str?); bashio returns "null" when unset.
_tg_api_base="$(bashio::config 'telegram_bot_api_base')"
if [ "$_tg_api_base" != "null" ] && [ -n "$_tg_api_base" ]; then
    export TELEGRAM_BOT_API_BASE="$_tg_api_base"
fi
# v0.125.0 (#228): webhook auth is MANDATORY — the `webhook_auth_enabled`
# toggle is gone and setup-configs.sh always materializes
# /data/webhook_secret (the operator override when set, else a generated
# one). Export the override only when it is a real value: bashio returns the
# literal string "null" for an unset optional, and casa_core.py treats a
# non-empty WEBHOOK_SECRET as authoritative over the secret file — exporting
# "null" would make that literal word the HMAC key while every signer used
# the file, so nothing would verify.
#
# The option is the ONLY source of an override, so clear any inherited value
# first (Sol review): this runs under `with-contenv`, which imports the
# container environment, and a WEBHOOK_SECRET arriving that way would outrank
# /data/webhook_secret in casa_core while every signer still used the file.
unset WEBHOOK_SECRET
_webhook_secret="$(bashio::config 'webhook_secret')"
if [ "$_webhook_secret" != "null" ] && [ -n "$_webhook_secret" ]; then
    export WEBHOOK_SECRET="$_webhook_secret"
fi
unset _webhook_secret
# v0.110.0 (#232): the context7 plugin is SEEDED (part of the shipped
# plugin-developer toolbox), so its key is static app config — an add-on
# option, not an engagement-wired vault secret (that path is for dynamically
# installed plugins). Exported only when set; plugin-env.conf, sourced later
# by casa_core, still overrides it (operator override layer).
_casa_context7_key="$(bashio::config 'context7_api_key')"
if [ -n "$_casa_context7_key" ] && [ "$_casa_context7_key" != "null" ]; then
    export CONTEXT7_API_KEY="$_casa_context7_key"
fi
unset _casa_context7_key

# Compat shim (v0.108.0, one migration cycle): the *_AGENT_NAME options are
# removed, but an upgraded /config whose baseline character/prompt files
# drifted from defaults (so the reconciler kept the user copy) may still
# contain ${PRIMARY_AGENT_NAME}/${VOICE_AGENT_NAME} placeholders — which
# would now render literally. Export the fixed fallbacks so they resolve.
export PRIMARY_AGENT_NAME="Ellen"
export VOICE_AGENT_NAME="Tina"
# #205: guard these two the way setup-configs.sh already does. Both are
# `list(...)?` — OPTIONAL — in config.yaml's schema, so their `options:` block
# entries are INSTALL-TIME defaults, not a permanent guarantee that the key is
# present in the stored options: an operator who clears the field leaves it
# absent and bashio yields the literal "null". Exported unguarded, that "null"
# survives role_slot._ha_model_options (which only defaults on a BLANK value)
# and reaches resolve_role_model, which rejects it as outside the role's
# allowed list — a RoleValidationError that FATALs every resident at boot.
# setup-configs.sh:214-219 already applies exactly this fallback for its
# config_sync boot-parity replay, so the unguarded export here meant the
# validator could pass while the real boot crash-looped.
_casa_primary_model="$(bashio::config 'primary_agent_model')"
_casa_voice_model="$(bashio::config 'voice_agent_model')"
[ -n "$_casa_primary_model" ] && [ "$_casa_primary_model" != "null" ] || _casa_primary_model=opus
[ -n "$_casa_voice_model" ] && [ "$_casa_voice_model" != "null" ] || _casa_voice_model=haiku
export PRIMARY_AGENT_MODEL="$_casa_primary_model"
export VOICE_AGENT_MODEL="$_casa_voice_model"
unset _casa_primary_model _casa_voice_model
export ENABLE_TERMINAL="$(bashio::config 'enable_terminal')"
export CASA_VERSION="$(bashio::addon.version)"

# 3.3: scheduler timezone — optional; timekeeping.resolve_tz() falls back
# to the TZ env var set by HA OS, then Europe/Amsterdam.
_casa_tz="$(bashio::config 'casa_tz')"
if [ "$_casa_tz" != "null" ] && [ -n "$_casa_tz" ]; then
    export CASA_TZ="$_casa_tz"
fi

# v0.18.1: operator-facing log level. install_logging() at
# casa_core.py:743 reads LOG_LEVEL env when set; falls back to INFO
# when unset/null/empty.
_log_level="$(bashio::config 'log_level')"
if [ "$_log_level" != "null" ] && [ -n "$_log_level" ]; then
    export LOG_LEVEL="$_log_level"
fi

# D-4 (v0.69.0): stale-engagement reap TTL in days; 0 disables the reap.
# tools._engagement_reap_days() falls back to 7 when unset/invalid.
_reap_days="$(bashio::config 'engagement_reap_days')"
if [ "$_reap_days" != "null" ] && [ -n "$_reap_days" ]; then
    export ENGAGEMENT_REAP_DAYS="$_reap_days"
fi

# Specialist concurrency/cost-alert options. Both ship with a default in the
# options block above, so bashio never returns "null" here (unlike the
# optional str?/int? options above) — export unconditionally, matching
# TELEGRAM_ENGAGEMENT_SUPERGROUP_ID. casa_core.py still validates on top.
#
# v0.125.0 (#228): the four voice_* tuning options that used to be exported
# here are gone. The turn budget is derived from the transport timeout in
# channels/voice/channel.py; route freshness, delivery TTL and the route cap
# are constants in voice_delivery_config.py.
export SPECIALIST_MAX_CONCURRENCY="$(bashio::config 'specialist_max_concurrency')"
export SPECIALIST_COST_ALERT_THRESHOLD="$(bashio::config 'specialist_cost_alert_threshold')"

# SUPERVISOR_TOKEN is injected automatically by the HA Supervisor.

exec /opt/casa/venv/bin/python3 /opt/casa/casa_core.py
